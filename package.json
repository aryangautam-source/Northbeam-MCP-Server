{
  "name": "northbeam-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Local stdio MCP server for Northbeam marketing analytics",
  "main": "src/index.js",
  "bin": {
    "northbeam-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "inspect": "npx -y @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.34",
    "ip-address": "^10.3.1",
    "path-to-regexp": "^8.4.2"
  }
}
